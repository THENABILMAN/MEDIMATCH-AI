# MediMatch AI — Environment Configuration Example
# Copy this file to .env and fill in the values for your local environment.

# development | production. Production turns off API docs and refuses fake embeddings
ENVIRONMENT=development

# Credentialed browser origins allowed to call the backend
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ==============================================================================
# Supabase Configuration
# ==============================================================================
# URL of your Supabase project (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Public anon key safe for clients to interact with Supabase (respects RLS)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Privileged service role key (NEVER expose to frontend; backend use only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL connection string for migrations and ORM
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ==============================================================================
# MongoDB vector search
# ==============================================================================
# `docker compose up -d mongo` runs it on this machine. A MongoDB Atlas link works too
MONGODB_URI=mongodb://localhost:27018/?directConnection=true
MONGODB_DATABASE=medimatch
MONGODB_DOCTORS=doctors
# Medical books: each document needs text, source and embedding. Empty turns the books off
MONGODB_BOOKS=medical_books

# ==============================================================================
# Local models from Hugging Face, run by Ollama
# ==============================================================================
OLLAMA_URL=http://localhost:11434
# Built once with: ollama create medimatch -f backend/models/Modelfile
LLM_MODEL=medimatch

# The assistant suggests doctors once it is this sure, after at least this many questions
SURE_CONFIDENCE=80
MIN_QUESTIONS=3
MAX_QUESTIONS=8

# ollama, or fake for tests. Books must be embedded with the same model
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=hf.co/gpustack/bge-m3-GGUF:Q8_0
EMBEDDING_DIMENSION=1024

# ==============================================================================
# Search
# ==============================================================================
# Vector matches fetched before Postgres filtering
VECTOR_CANDIDATES=30
# Run vector sync after the response. Tests turn this off
SYNC_IN_BACKGROUND=true
# Ranking weights. Must add up to 1.0
WEIGHT_VECTOR=0.40
WEIGHT_SPECIALTY=0.25
WEIGHT_EXPERIENCE=0.15
WEIGHT_FEE=0.10
WEIGHT_AVAILABILITY=0.10

# ==============================================================================
# Safety, Privacy and Limits
# ==============================================================================
# Number shown in every emergency alert
EMERGENCY_NUMBER=999

# TODO before launch: add crisis support lines as JSON, and verify every number yourself.
# Left empty on purpose. Crisis messages then show only EMERGENCY_NUMBER.
# Format: [{"name": "Line name", "number": "...", "hours": "24 hours"}]
CRISIS_HELPLINES=[]
# Chats untouched for this many days are erased by scripts/purge_expired.py
CHAT_RETENTION_DAYS=365
# Upcoming appointments one patient can hold
MAX_ACTIVE_BOOKINGS=5
# Requests per minute, per worker
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_CHAT=20
RATE_LIMIT_UPLOAD=10
# Bytes
MAX_UPLOAD_BYTES=10485760
MAX_REQUEST_BYTES=11534336
SUPABASE_TIMEOUT_SECONDS=10
