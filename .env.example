# MediMatch AI — Environment Configuration Example
# Copy this file to .env and fill in the values for your local environment.

# Credentialed browser origins allowed to call the backend
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ==============================================================================
# Supabase Configuration
# ==============================================================================
# URL of your Supabase project (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Public anon key safe for clients to interact with Supabase (respects RLS)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Privileged service role key (NEVER expose to frontend; backend use only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL connection string for migrations and ORM
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ==============================================================================
# Pinecone Vector Database Configuration
# ==============================================================================
# API key from https://app.pinecone.io
PINECONE_API_KEY=your-pinecone-api-key

# Name of your Pinecone index for doctor embeddings
PINECONE_INDEX=medimatch-doctors

# ==============================================================================
# OpenRouter / LLM Configuration
# ==============================================================================
# API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# Target model for the symptom matching LangGraph agent
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# ==============================================================================
# Embedding Provider Configuration
# ==============================================================================
# Provider to use for generating text embeddings (e.g., "pinecone", "fake", "openai")
EMBEDDING_PROVIDER=pinecone

# Model name for generating doctor profile and symptom embeddings (matches 1024-dim index)
EMBEDDING_MODEL=llama-text-embed-v2
EMBEDDING_DIMENSION=1024
