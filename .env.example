# MediMatch AI — Environment Configuration Example
# Copy this file to .env and fill in the values for your local environment.

# development | production. Production turns off API docs and refuses fake embeddings
ENVIRONMENT=development

# Credentialed browser origins allowed to call the backend
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ==============================================================================
# Supabase Configuration
# ==============================================================================
# URL of your Supabase project (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Public anon key safe for clients to interact with Supabase (respects RLS)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Privileged service role key (NEVER expose to frontend; backend use only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL connection string for migrations and ORM
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ==============================================================================
# Pinecone Vector Database Configuration
# ==============================================================================
# API key from https://app.pinecone.io
PINECONE_API_KEY=your-pinecone-api-key

# Name of your Pinecone index for doctor embeddings
PINECONE_INDEX=medimatch-doctors

# ==============================================================================
# Groq / LLM Configuration
# ==============================================================================
# API key from https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# The account limit is shared by every model, so changing model does not raise it
GROQ_MODEL=openai/gpt-oss-120b

# How long a chat turn can hold a worker: 2 calls x attempts x timeout
LLM_TIMEOUT_SECONDS=15
LLM_MAX_ATTEMPTS=2
# Latest messages sent to the LLM each turn
LLM_HISTORY_MESSAGES=12

# ==============================================================================
# Embedding Provider Configuration
# ==============================================================================
# pinecone, or fake for local development. Any other value stops search with an error
EMBEDDING_PROVIDER=pinecone

# Model name for generating doctor profile and symptom embeddings (matches 1024-dim index)
EMBEDDING_MODEL=llama-text-embed-v2
EMBEDDING_DIMENSION=1024

# ==============================================================================
# Search
# ==============================================================================
# Vector matches fetched before Postgres filtering
VECTOR_CANDIDATES=30
PINECONE_TIMEOUT_SECONDS=5
# Run vector sync after the response. Tests turn this off
SYNC_IN_BACKGROUND=true
# Ranking weights. Must add up to 1.0
WEIGHT_VECTOR=0.40
WEIGHT_SPECIALTY=0.25
WEIGHT_EXPERIENCE=0.15
WEIGHT_FEE=0.10
WEIGHT_AVAILABILITY=0.10

# ==============================================================================
# Safety, Privacy and Limits
# ==============================================================================
# Number shown in every emergency alert
EMERGENCY_NUMBER=999
# Chats untouched for this many days are erased by scripts/purge_expired.py
CHAT_RETENTION_DAYS=365
# Upcoming appointments one patient can hold
MAX_ACTIVE_BOOKINGS=5
# Requests per minute, per worker
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_CHAT=20
RATE_LIMIT_UPLOAD=10
# Bytes
MAX_UPLOAD_BYTES=10485760
MAX_REQUEST_BYTES=11534336
SUPABASE_TIMEOUT_SECONDS=10
